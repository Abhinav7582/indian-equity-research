# ---------------------------------------------------------------------------
# Example environment file for the Indian Equity Research System.
#
#   cp .env.example .env      then edit .env with local values.
#
# .env is git-ignored. NEVER commit real credentials.
# These are LOCAL DEVELOPMENT placeholders only. There are no broker,
# exchange or market-data credentials in this project and none are needed:
# Phase 1 performs no network access of any kind.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=equity_research
DATABASE_USER=equity_user
DATABASE_PASSWORD=replace_me
DATABASE_SSL_MODE=prefer
